<UserControl x:Class="Friday.Desktop.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Width="720"
             FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <!-- Gölge için kenar boşluğu bırakılır. -->
    <Grid Margin="28,20,28,30">
        <Border CornerRadius="38" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2161A24" Offset="0"/>
                    <GradientStop Color="#F20B0D13" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#0CFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Üst kenarda durum renginde ince bir ışık. -->
                <Rectangle Height="1.5" VerticalAlignment="Top" Margin="60,0" Fill="{Binding StateGlow}"/>

                <Grid Margin="10,8,22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <local:AudioRing x:Name="Ring" Width="84" Height="84" Level="{Binding Level}" State="{Binding State}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                       Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UserText, StringFormat='  ·  “{0}”'}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center"
                                       Visibility="{Binding HasUserText, Converter={StaticResource Visible}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Caption}" FontFamily="{StaticResource DisplayFont}" FontSize="16.5" LineHeight="23"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasCaption, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Çalışan araç. -->
                        <Border CornerRadius="12" Padding="10,6" Background="#14FFFFFF" Margin="0,2"
                                Visibility="{Binding HasTool, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding ToolGlyph}" FontSize="13" Foreground="{Binding StateBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding ToolLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Mikrofon gerçekten açıkken. -->
                        <Border CornerRadius="12" Padding="10,6" Background="#26FF5C7A" Margin="0,2"
                                Visibility="{Binding IsMicOpen, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Foreground="{StaticResource ListeningBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Mikrofon açık" FontSize="12" Foreground="{StaticResource ListeningBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
