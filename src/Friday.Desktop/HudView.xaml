<UserControl x:Class="Friday.Desktop.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Width="680"
             FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <!-- Gölge için kenar boşluğu bırakılır. -->
    <Grid Margin="28,18,28,30">
        <Border CornerRadius="26" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01C1C1F" Offset="0"/>
                    <GradientStop Color="#F2111113" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="12,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <local:AudioRing x:Name="Ring" Width="64" Height="64" Level="{Binding Level}" State="{Binding State}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserText, StringFormat='  “{0}”'}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center"
                                   Visibility="{Binding HasUserText, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Caption}" FontFamily="{StaticResource DisplayFont}" FontSize="16" LineHeight="22"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasCaption, Converter={StaticResource Visible}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- Çalışan araç. -->
                    <Border CornerRadius="10" Padding="10,5" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Margin="0,2"
                            Visibility="{Binding HasTool, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ToolGlyph}" FontSize="12" Foreground="{Binding StateBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ToolLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Mikrofon gerçekten açıkken. -->
                    <Border CornerRadius="10" Padding="10,5" Background="#1FFF8A5B" Margin="0,2"
                            Visibility="{Binding IsMicOpen, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource ListeningBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Mikrofon açık" FontSize="12" Foreground="{StaticResource ListeningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
