<UserControl x:Class="Friday.Desktop.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Width="680"
             FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <!-- Gölge için kenar boşluğu bırakılır. -->
    <StackPanel Margin="28,18,28,30">
        <!-- Cevabın görsel kartı: hava, durum raporu, döviz, hatırlatmalar… -->
        <Border CornerRadius="22" BorderThickness="1" Margin="0,0,0,10" Visibility="{Binding HasCard, Converter={StaticResource Visible}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01C1C1F" Offset="0"/>
                    <GradientStop Color="#F2111113" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel DataContext="{Binding Card}" Margin="22,16,22,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasBig, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Big}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding BigCaption}" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="14,0,0,11"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Gauges}" Margin="0,10,0,0" Visibility="{Binding HasGauges, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border CornerRadius="3" Background="#24FFFFFF"/>
                                    <Border CornerRadius="3" RenderTransformOrigin="0,0.5" Background="{StaticResource SpeakingBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Value}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0" Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0"
                                           VerticalAlignment="Top" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border CornerRadius="26" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F01C1C1F" Offset="0"/>
                    <GradientStop Color="#F2111113" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="12,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <local:AudioRing x:Name="Ring" Width="64" Height="64" Level="{Binding Level}" State="{Binding State}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserText, StringFormat='  “{0}”'}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center"
                                   Visibility="{Binding HasUserText, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Caption}" FontFamily="{StaticResource DisplayFont}" FontSize="16" LineHeight="22"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasCaption, Converter={StaticResource Visible}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- Çalışan araç. -->
                    <Border CornerRadius="10" Padding="10,5" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Margin="0,2"
                            Visibility="{Binding HasTool, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ToolGlyph}" FontSize="12" Foreground="{Binding StateBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ToolLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Mikrofon gerçekten açıkken. -->
                    <Border CornerRadius="10" Padding="10,5" Background="#1FFF8A5B" Margin="0,2"
                            Visibility="{Binding IsMicOpen, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource ListeningBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Mikrofon açık" FontSize="12" Foreground="{StaticResource ListeningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
