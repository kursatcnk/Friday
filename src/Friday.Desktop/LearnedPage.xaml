<UserControl x:Class="Friday.Desktop.LearnedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop">
    <Grid Margin="36,4,24,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0" MaxWidth="1180" HorizontalAlignment="Stretch">
                <DockPanel Margin="2,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LearnedMessage}" Foreground="{DynamicResource CalmBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    <TextBlock Text="{Binding LearnedSummary}" Style="{StaticResource Caption}"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding LearnedGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:AdaptiveGrid MinItemWidth="340" Gap="14" Margin="0,0,0,14" MaxColumns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LearnedGroupView}">
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource FaintBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource FaintBrush}" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <TextBlock Text="Henüz yok." Foreground="{DynamicResource FaintBrush}" FontSize="12"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:LearnedItemView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                                                    </StackPanel>
                                                    <Button x:Name="Forget" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Unut" Width="26" Height="26"
                                                            VerticalAlignment="Top" Opacity="0.35" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ForgetLearnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Forget" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
