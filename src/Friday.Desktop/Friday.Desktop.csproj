<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Yalnızca sistem tepsisi simgesi (NotifyIcon) için. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe, görev çubuğu, Alt+Tab ve tepsi aynı simgeyi kullanır. -->
    <ApplicationIcon>Assets\Friday.ico</ApplicationIcon>
    <AssemblyName>Friday</AssemblyName>
    <Version>0.28.0</Version>
    <!-- Arka planda bekleyen bir asistan: eşzamanlı GC'nin ayrı yığını ve iş parçacığı gereksiz; bellek sıkı tutulur. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms'un örtük using'leri WPF türleriyle çakışır; tepsi kodunda tam adlar kullanılır. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Friday.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Friday.Core\Friday.Core.csproj" />
    <ProjectReference Include="..\Friday.Infrastructure\Friday.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0–9: yüksek değer, biraz daha sık GC karşılığında yığının boşta daha az RAM tutması demek. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
