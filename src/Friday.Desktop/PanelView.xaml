<UserControl x:Class="Friday.Desktop.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource TextFont}"
             FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- Sol gezinme: simge ve küçük etiket; seçili olan sıcak beyaz, yanında ince kor çizgi. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Height="56">
                            <Rectangle x:Name="Bar" Width="2" Height="18" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}" Opacity="0"/>
                            <Border x:Name="Pill" Width="52" Height="50" CornerRadius="14" Background="Transparent" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" TextElement.FontSize="10"
                                                      TextElement.FontFamily="{StaticResource SmallFont}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sol gezinme ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,16">
                <local:AudioRing DockPanel.Dock="Top" x:Name="NavRing" Width="46" Height="46" Margin="0,0,0,22"
                                 Level="{Binding Level}" State="{Binding State}"/>
                <Ellipse DockPanel.Dock="Bottom" Width="7" Height="7" Fill="{Binding StateBrush}" ToolTip="{Binding StatusText}"/>
                <StackPanel Margin="6,0,0,0">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Bugün" IsChecked="{Binding IsToday}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="Sohbet" IsChecked="{Binding IsChat}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Ritim" IsChecked="{Binding IsRhythm}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Hafıza" IsChecked="{Binding IsMemory}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Rutinler" IsChecked="{Binding IsRoutines}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Gizlilik" IsChecked="{Binding IsPrivacy}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Ayarlar" IsChecked="{Binding IsSettings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Üst bilgi ================= -->
            <Grid Margin="36,24,32,12">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="1,0,9,0"
                                 Visibility="{Binding IsChat, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChipButton}" Padding="9,3" Margin="0,0,10,0" ToolTip="Rahatsız etmeyi kapat"
                                Command="{Binding EndQuietNowCommand}" Visibility="{Binding QuietBadge, Converter={StaticResource TextVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding QuietBadge}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border CornerRadius="9" Padding="9,3" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Margin="0,0,10,0" Visibility="{Binding WakeEnabled, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding WakeLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding HotkeyKeys}" ItemTemplate="{StaticResource KeyCap}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyNote}" Foreground="{StaticResource WarningBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ================= Bugün ================= -->
                <ScrollViewer Visibility="{Binding IsToday, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Margin="36,4,24,24">
                    <StackPanel Margin="0,0,12,0" MaxWidth="1180" HorizontalAlignment="Stretch">
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,6" Command="{Binding ToggleHomeEditorCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HomeEditorLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <!-- Ana ekranı düzenle: kartları aç/kapat ve sırala. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="#40FF8A5B"
                                Visibility="{Binding IsCustomizingHome, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Ana ekranı düzenle" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="Kartları aç, kapat ve oklarla sırala; değişiklik hemen uygulanır. Geniş kartlar tam satır, diğerleri ikişer yan yana durur."/>
                                <ItemsControl ItemsSource="{Binding HomeCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Visible}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </CheckBox>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Padding="7" ToolTip="Yukarı taşı"
                                                        Command="{Binding DataContext.MoveHomeCardUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11"/>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="7" ToolTip="Aşağı taşı"
                                                        Command="{Binding DataContext.MoveHomeCardDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Bitti" Command="{Binding ToggleHomeEditorCommand}" Padding="16,7" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Varsayılana dön" Command="{Binding ResetHomeCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <local:CardFlowPanel x:Name="TodayCards" Gap="14">
                        <!-- Selam ve hava. -->
                        <Border local:CardFlowPanel.Key="greeting" local:CardFlowPanel.Wide="True" Style="{StaticResource Card}" Padding="26,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:AudioRing x:Name="TodayRing" Width="86" Height="86" Level="{Binding Level}" State="{Binding State}" Margin="-8,-6,14,-6"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeGreeting}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding WakeHint}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"
                                            Visibility="{Binding HasWeather, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding WeatherTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding WeatherSummary}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- İlk açılış: tanışma. -->
                        <Border local:CardFlowPanel.Key="intro" local:CardFlowPanel.Wide="True" Style="{StaticResource Card}" Visibility="{Binding NeedsIntro, Converter={StaticResource Visible}}"
                                BorderBrush="#40FF8A5B">
                            <StackPanel>
                                <TextBlock Text="Tanışalım" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                                           Text="Sana adınla hitap edeyim ve hava durumunu doğru şehir için söyleyeyim. Başka bir yapay zekâ seni zaten tanıyorsa hafızasını da buraya taşıyabilirsin."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Adın" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding IntroName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Şehrin" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding IntroCity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Kaydet" Command="{Binding SaveIntroCommand}"
                                            VerticalAlignment="Bottom" Margin="12,0,0,0" Padding="18,10"/>
                                </Grid>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding GoToCommand}" CommandParameter="import">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="ChatGPT, Claude ya da Gemini hafızamı aktar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                            <!-- Yaklaşanlar. -->
                            <Border local:CardFlowPanel.Key="upcoming" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Yaklaşanlar" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Visibility="{Binding HasUpcoming, Converter={StaticResource Hidden}}"
                                               Text="Yaklaşan bir şey yok. &quot;Yarın 9'da doktoru hatırlat&quot; ya da &quot;10 dakika sonra çayı hatırlat&quot; diyebilirsin."/>
                                    <ItemsControl ItemsSource="{Binding Upcoming}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:UpcomingView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="8" Padding="8,3" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,1,10,0">
                                                        <TextBlock Text="{Binding When}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" x:Name="Remove" Style="{StaticResource IconButton}" ToolTip="Hatırlatmayı sil" Opacity="0" Padding="6"
                                                            Visibility="{Binding IsReminder, Converter={StaticResource Visible}}"
                                                            Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding ReminderId}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Günün planı: takvim, işler ve alışkanlıklar saat saat (dil modelsiz, anında). -->
                            <Border local:CardFlowPanel.Key="plan" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Günün planı" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding PlanRows.Count, Converter={StaticResource ZeroVisible}}"
                                               Text="Planlanacak bir iş yok. &quot;Yapılacaklara ekle: cumaya kadar raporu bitir&quot; de; işlerini takvimin arasına yerleştireyim."/>
                                    <ItemsControl ItemsSource="{Binding PlanRows}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PlanRow}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="When" Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                                    <Ellipse x:Name="Dot" Grid.Column="1" Width="7" Height="7" HorizontalAlignment="Left" Fill="#2CFFFFFF"/>
                                                    <TextBlock x:Name="What" Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Focus">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Event">
                                                        <Setter TargetName="Dot" Property="Fill" Value="#6FB7FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Habit">
                                                        <Setter TargetName="Dot" Property="Fill" Value="#7FD4B0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                        <Setter TargetName="What" Property="FontWeight" Value="SemiBold"/>
                                                        <Setter TargetName="When" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Sesli planla, hatırlatmaları kur"
                                            Command="{Binding SuggestCommand}" CommandParameter="Günümü planla"
                                            Visibility="{Binding HasPlan, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Ritim. -->
                            <Border local:CardFlowPanel.Key="rhythm" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Ritim" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="4" ToolTip="Ritim sayfası"
                                                Command="{Binding GoToCommand}" CommandParameter="rhythm">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="64" Margin="0,0,14,0">
                                            <local:ProgressDial Progress="{Binding DialProgress}" Color="{Binding DialColor}" Thickness="6"/>
                                            <TextBlock Text="{Binding DialClock}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                                                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DialLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RhythmActive, StringFormat='Bugün {0} bilgisayar başında'}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DialSentence}" Style="{StaticResource Body}" FontSize="12" Margin="0,10,0,12"/>
                                    <WrapPanel Margin="-4,0,0,0">
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="Mola ver" Command="{Binding RhythmCommand}" CommandParameter="Mola ver"/>
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="25 dk odak" Command="{Binding RhythmCommand}" CommandParameter="25 dakika odaklanacağım"/>
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="Nefes" Command="{Binding RhythmCommand}" CommandParameter="Nefes egzersizi yapalım"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <!-- Yapılacaklar. -->
                            <Border local:CardFlowPanel.Key="todos" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Yapılacaklar" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding TodoSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Todos}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:TodoView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Top" Margin="0,1,0,0"
                                                              Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Label" Text="{Binding Display}" TextWrapping="Wrap" LineHeight="19"/>
                                                        <TextBlock x:Name="Due" Text="{Binding DueLabel}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                                   Visibility="{Binding HasDue, Converter={StaticResource Visible}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" x:Name="Remove" Style="{StaticResource IconButton}" ToolTip="Sil" Opacity="0" Padding="5"
                                                            Command="{Binding DataContext.RemoveTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                        <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                        <Setter TargetName="Due" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <TextBox Text="{Binding NewTodo, UpdateSourceTrigger=PropertyChanged}" Padding="12,7" FontSize="12.5" AutomationProperties.Name="Yeni iş">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="Yeni iş ekle, Enter'a bas" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewTodo}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Alışkanlıklar: bugünün işareti, son 7 gün ve seri. -->
                            <Border local:CardFlowPanel.Key="habits" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Alışkanlıklar" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding HabitSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HabitRows.Count, Converter={StaticResource ZeroVisible}}"
                                               Text="Her gün yapmak istediğin şeyleri ekle; &quot;bugün spor yaptım&quot; deyince işaretleyip serini sayarım."/>
                                    <ItemsControl ItemsSource="{Binding HabitRows}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:HabitView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsDoneToday, Mode=OneWay}" VerticalAlignment="Center" ToolTip="Bugün yaptım"
                                                              Command="{Binding DataContext.ToggleHabitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Streak}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Week}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:HabitDay}">
                                                                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="2.5,0" Fill="#2CFFFFFF" ToolTip="{Binding Tip}"/>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource MutedBrush}"/>
                                                                        <Setter TargetName="Dot" Property="StrokeThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Grid.Column="3" x:Name="Remove" Style="{StaticResource IconButton}" ToolTip="Takipten çıkar" Opacity="0" Padding="5" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RemoveHabitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <TextBox Text="{Binding NewHabit, UpdateSourceTrigger=PropertyChanged}" Padding="12,7" FontSize="12.5" AutomationProperties.Name="Yeni alışkanlık">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddHabitCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="Yeni alışkanlık, ör. kitap okumak" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewHabit}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Harcamalar: bu ayın toplamı, bütçe ve kategoriler. -->
                            <Border local:CardFlowPanel.Key="spending" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Harcamalar" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding SpendingCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SpendingTotal}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <StackPanel Visibility="{Binding HasBudget, Converter={StaticResource Visible}}" Margin="0,6,0,2">
                                        <Grid Height="6">
                                            <Border CornerRadius="3" Background="{StaticResource LineBrush}"/>
                                            <Border CornerRadius="3" HorizontalAlignment="Left" Opacity="0.85">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                                                <Setter Property="Background" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource Fraction}">
                                                        <Binding Path="BudgetFraction"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding BudgetText}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BillsText}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BillsText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasSpending, Converter={StaticResource Hidden}}"
                                               Text="&quot;Kahveye 80 lira harcadım&quot; de, kaydedeyim. &quot;Aylık bütçem 15 bin lira&quot; dersen bütçeyi de takip ederim."/>
                                    <ItemsControl ItemsSource="{Binding SpendingRows}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:SpendingRow}">
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1" Height="5" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Border CornerRadius="2.5" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Opacity="0.7">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource Fraction}">
                                                                    <Binding Path="Fraction"/>
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding RecentExpenses}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExpenseView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <Button Grid.Column="2" x:Name="Remove" Style="{StaticResource IconButton}" ToolTip="Harcamayı sil" Opacity="0" Padding="5" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.RemoveExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Kelime pratiği: bugün bekleyen tekrarlar ve öğrenilenler. -->
                            <Border local:CardFlowPanel.Key="vocabulary" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Kelime pratiği" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding VocabularyCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding VocabularyDue}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VocabularyDetail}" Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Çalış" Padding="16,7" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding StartPracticeCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Notlar. -->
                            <Border local:CardFlowPanel.Key="notes" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Notlar" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="4" ToolTip="notes.md'yi aç"
                                                Command="{Binding OpenNotesCommand}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasNotes, Converter={StaticResource Hidden}}"
                                               Text="&quot;Not al: süt ve ekmek&quot; de, buraya yazayım. &quot;Notlarımı oku&quot; deyince okurum."/>
                                    <ItemsControl ItemsSource="{Binding RecentNotes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:NoteView}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        <!-- Ekran süresi: en çok kullanılan uygulamalar ve siteler. -->
                        <Border local:CardFlowPanel.Key="screentime" local:CardFlowPanel.Wide="True" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Ekran süresi" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding ScreenTimeSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ScreenTimeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding App}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Height="6" CornerRadius="3" Width="{Binding Width}" HorizontalAlignment="Left"
                                                        Background="{StaticResource AccentBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                            <!-- Söyleyebileceklerin. -->
                            <Border local:CardFlowPanel.Key="ideas" local:CardFlowPanel.Wide="True" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Dene" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TodayIdeas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Margin="-4,0,0,0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding}" Padding="11,6"
                                                        Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        <!-- Rutinler: tek tıkla çalıştır. -->
                        <Border local:CardFlowPanel.Key="routines" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Rutinler" Style="{StaticResource SectionTitle}"/>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="4" ToolTip="Rutinler sayfası"
                                            Command="{Binding GoToCommand}" CommandParameter="routines">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="Henüz rutin yok; Rutinler sayfasından ekleyebilirsin." TextWrapping="Wrap"
                                           Visibility="{Binding HomeRoutines.Count, Converter={StaticResource ZeroVisible}}"/>
                                <ItemsControl ItemsSource="{Binding HomeRoutines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Margin="-4,0,0,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChipButton}" Padding="11,6"
                                                    Command="{Binding DataContext.RunRoutineHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- Sistem: işlemci, bellek, ekran kartı, disk. -->
                        <Border local:CardFlowPanel.Key="system" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Sistem" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SystemRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border CornerRadius="3" Background="{StaticResource LineBrush}"/>
                                                    <Border CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Opacity="0.85">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource Fraction}">
                                                                <Binding Path="Fraction"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SystemNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        </local:CardFlowPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= Sohbet ================= -->
                <local:ChatPage x:Name="ChatView" Visibility="{Binding IsChat, Converter={StaticResource Visible}}"/>

                <!-- ================= Ritim ================= -->
                <local:RhythmPage Visibility="{Binding IsRhythm, Converter={StaticResource Visible}}"/>

                <!-- ================= Hafıza ================= -->
                <Grid Visibility="{Binding IsMemory, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{Binding MemorySummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ImportFileCommand}" Margin="0,0,8,0"
                                    ToolTip="ChatGPT, Claude ya da Gemini'den .txt, .md ya da .json">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dosyadan aktar"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding TogglePasteCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Metin yapıştır"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CopyForAiCommand}" Margin="0,0,8,0"
                                    ToolTip="Başka bir yapay zekâya yapıştırılacak mesajı panoya koyar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Başka bir AI'ya taşı"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding ExportMemoryCommand}" ToolTip="Markdown olarak dışa aktar">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Metin yapıştırma kutusu. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsPasteOpen, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="2,0,0,10"
                                       Text="ChatGPT'de Ayarlar › Kişiselleştirme › Hafızayı yönet listesini, Claude ya da Gemini'nin kayıtlı bilgilerini buraya yapıştır."/>
                            <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="130" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding TogglePasteCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource AccentButton}" Content="Bilgileri ayıkla" Command="{Binding ParsePasteCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Elle ekleme. -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <TextBox Text="{Binding NewMemory, UpdateSourceTrigger=PropertyChanged}" Padding="16,11,110,11">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddMemoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Bir bilgi ekle: ör. Kahveyi şekersiz içerim." Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"
                                   Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewMemory}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource AccentButton}" Content="Hatırla" Command="{Binding AddMemoryCommand}"
                                HorizontalAlignment="Right" Margin="0,0,5,0" Height="32"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasImport, Converter={StaticResource Hidden}}">
                            <StackPanel>
                                <TextBlock Text="{Binding MemoryMessage}" Foreground="{StaticResource CalmBrush}" FontSize="12" Margin="2,2,0,10"/>
                                <TextBlock Text="Henüz bir şey hatırlamıyorum. &quot;Unutma, …&quot; demen ya da başka bir yapay zekâdan aktarman yeter."
                                           Foreground="{StaticResource FaintBrush}" Margin="0,24,0,0" HorizontalAlignment="Center"
                                           Visibility="{Binding HasMemories, Converter={StaticResource Hidden}}"/>
                                <ItemsControl ItemsSource="{Binding Memories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:MemoryView}">
                                            <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,13,4,13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/>
                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="9" Padding="10,4" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                                                            Margin="12,0,6,0" Visibility="{Binding HasCountdown, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{Binding Countdown}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2" x:Name="Forget" Style="{StaticResource IconButton}" ToolTip="Unut" Opacity="0"
                                                            Command="{Binding DataContext.ForgetMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Forget" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- İçe aktarma önizlemesi. -->
                        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasImport, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportSource, StringFormat='{}{0} hafızası'}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding CancelImportCommand}" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Seçilenleri hatırla" Command="{Binding ConfirmImportCommand}"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ImportCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ImportCandidateView}">
                                                <Grid Margin="12,8,12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Fact" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20"/>
                                                        <TextBlock Text="Zaten biliyorum" Style="{StaticResource Caption}"
                                                                   Visibility="{Binding AlreadyKnown, Converter={StaticResource Visible}}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding AlreadyKnown}" Value="True">
                                                        <Setter TargetName="Fact" Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Gizlilik ================= -->
                <Grid Visibility="{Binding IsPrivacy, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="-6,0,-6,18">
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Mikrofon" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding MicrophoneSummary}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Bilgisayarda kalan" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding LocalCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource CalmBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Dışarı giden" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding OutboundCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="1" Text="Bugünün defteri" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ledger}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LedgerView}">
                                    <Grid Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,13,0,0"/>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource LineBrush}" HorizontalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" x:Name="Dot" Width="7" Height="7" Fill="{StaticResource CalmBrush}" VerticalAlignment="Top" Margin="0,16,0,0"/>
                                        <StackPanel Grid.Column="2" Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="19"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" x:Name="FlowText" Text="{Binding FlowLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource CalmBrush}"
                                                   VerticalAlignment="Top" Margin="0,13,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="FlowText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Rutinler ================= -->
                <local:RoutinesPage Visibility="{Binding IsRoutines, Converter={StaticResource Visible}}"/>

                <!-- ================= Ayarlar ================= -->
                <local:SettingsPage x:Name="SettingsView" Visibility="{Binding IsSettings, Converter={StaticResource Visible}}"/>
            </Grid>
        </Grid>

        <!-- ================= Komut paleti (Ctrl+K) ================= -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsPaletteOpen, Converter={StaticResource Visible}}" Background="#99000000" MouseDown="OnPaletteBackdrop">
            <Border Style="{StaticResource Card}" Width="640" VerticalAlignment="Top" Margin="0,90,0,0" Padding="14" MouseDown="OnPaletteCard">
                <StackPanel>
                    <Grid Margin="4,0,4,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="PaletteBox" Margin="26,0,0,0" FontSize="15" BorderThickness="0" Background="Transparent"
                                 Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnPaletteKey"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteItem}" Background="Transparent" BorderThickness="0"
                             MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnPaletteClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Caption}" Margin="4,8,4,0" Text="↑ ↓ seç · Enter çalıştır · Esc kapat · eşleşme yoksa Friday'e sorulur"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
