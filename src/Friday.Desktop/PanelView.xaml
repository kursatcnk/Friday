<UserControl x:Class="Friday.Desktop.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource TextFont}"
             FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <local:InverseVisibilityConverter x:Key="Hidden"/>

        <!-- Sol gezinme: simge ve küçük etiket; seçili olan sıcak beyaz, yanında ince kor çizgi. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Height="56">
                            <Rectangle x:Name="Bar" Width="2" Height="18" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}" Opacity="0"/>
                            <Border x:Name="Pill" Width="52" Height="50" CornerRadius="14" Background="Transparent" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" TextElement.FontSize="10"
                                                      TextElement.FontFamily="{StaticResource SmallFont}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tuş görünümlü küçük kutu (Ctrl, Alt, F). -->
        <DataTemplate x:Key="KeyCap">
            <Border CornerRadius="6" BorderThickness="1,1,1,2" BorderBrush="{StaticResource LineStrongBrush}" Background="{StaticResource SurfaceRaisedBrush}"
                    Padding="7,1" Margin="2,0" MinWidth="22">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource SmallFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- Sohbet: Friday'in cevabı balonsuz, düz ve okunaklı; kullanıcının cümlesi sağda ince bir hap. -->
        <DataTemplate x:Key="ChatLineTemplate" DataType="{x:Type local:ChatLine}">
            <Grid Margin="0,0,0,18">
                <Grid x:Name="Friday">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#FFF6E9" Offset="0"/>
                                <GradientStop Color="#F2CC8F" Offset="0.5"/>
                                <GradientStop Color="#6B5536" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="23" FontSize="14.5" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="User" HorizontalAlignment="Right" MaxWidth="520" Visibility="Collapsed">
                    <Border CornerRadius="18" Padding="16,9" Background="{StaticResource UserBubbleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,5,6,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Friday" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="User" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ritim sayfasındaki küçük istatistik kutusu. -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Ortak liste öğesi (ses, mikrofon seçimi). -->
        <Style x:Key="PillItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill" CornerRadius="10" Padding="12,6" Margin="3" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceRaisedBrush}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2A2A2F"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#66FF8A5B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sol gezinme ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,16">
                <local:AudioRing DockPanel.Dock="Top" x:Name="NavRing" Width="46" Height="46" Margin="0,0,0,22"
                                 Level="{Binding Level}" State="{Binding State}"/>
                <Ellipse DockPanel.Dock="Bottom" Width="7" Height="7" Fill="{Binding StateBrush}" ToolTip="{Binding StatusText}"/>
                <StackPanel Margin="6,0,0,0">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Bugün" IsChecked="{Binding IsToday}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="Sohbet" IsChecked="{Binding IsChat}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Ritim" IsChecked="{Binding IsRhythm}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Hafıza" IsChecked="{Binding IsMemory}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Rutinler" IsChecked="{Binding IsRoutines}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Gizlilik" IsChecked="{Binding IsPrivacy}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Ayarlar" IsChecked="{Binding IsSettings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Üst bilgi ================= -->
            <Grid Margin="36,24,32,12">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="1,0,9,0"
                                 Visibility="{Binding IsChat, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border CornerRadius="9" Padding="9,3" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Margin="0,0,10,0" Visibility="{Binding WakeEnabled, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding WakeLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding HotkeyKeys}" ItemTemplate="{StaticResource KeyCap}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyNote}" Foreground="{StaticResource WarningBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ================= Bugün ================= -->
                <ScrollViewer Visibility="{Binding IsToday, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Margin="36,4,24,24">
                    <StackPanel Margin="0,0,12,0" MaxWidth="900" HorizontalAlignment="Stretch">
                        <!-- Selam ve hava. -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:AudioRing x:Name="TodayRing" Width="86" Height="86" Level="{Binding Level}" State="{Binding State}" Margin="-8,-6,14,-6"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeGreeting}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding WakeHint}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"
                                            Visibility="{Binding HasWeather, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding WeatherTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding WeatherSummary}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- İlk açılış: tanışma. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding NeedsIntro, Converter={StaticResource Visible}}"
                                BorderBrush="#40FF8A5B">
                            <StackPanel>
                                <TextBlock Text="Tanışalım" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                                           Text="Sana adınla hitap edeyim ve hava durumunu doğru şehir için söyleyeyim. Başka bir yapay zekâ seni zaten tanıyorsa hafızasını da buraya taşıyabilirsin."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Adın" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding IntroName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Şehrin" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding IntroCity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Kaydet" Command="{Binding SaveIntroCommand}"
                                            VerticalAlignment="Bottom" Margin="12,0,0,0" Padding="18,10"/>
                                </Grid>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding GoToCommand}" CommandParameter="import">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="ChatGPT, Claude ya da Gemini hafızamı aktar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Yaklaşanlar. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Yaklaşanlar" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Visibility="{Binding HasUpcoming, Converter={StaticResource Hidden}}"
                                               Text="Yaklaşan bir şey yok. &quot;Yarın 9'da doktoru hatırlat&quot; ya da &quot;10 dakika sonra çayı hatırlat&quot; diyebilirsin."/>
                                    <ItemsControl ItemsSource="{Binding Upcoming}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:UpcomingView}">
                                                <Grid x:Name="Row" Background="Transparent" Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="8" Padding="8,3" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,1,10,0">
                                                        <TextBlock Text="{Binding When}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" x:Name="Remove" Style="{StaticResource IconButton}" ToolTip="Hatırlatmayı sil" Opacity="0" Padding="6"
                                                            Visibility="{Binding IsReminder, Converter={StaticResource Visible}}"
                                                            Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding ReminderId}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Ritim. -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Ritim" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="4" ToolTip="Ritim sayfası"
                                                Command="{Binding GoToCommand}" CommandParameter="rhythm">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding RhythmActive}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding RhythmStretch}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <Grid Height="5" Margin="0,0,0,14">
                                        <Border CornerRadius="3" Background="#222226"/>
                                        <Border CornerRadius="3" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding RhythmProgress}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <WrapPanel Margin="-4,0,0,0">
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="Mola ver" Command="{Binding RhythmCommand}" CommandParameter="Mola ver"/>
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="25 dk odak" Command="{Binding RhythmCommand}" CommandParameter="25 dakika odaklanacağım"/>
                                        <Button Style="{StaticResource GhostButton}" Margin="4" Content="Nefes" Command="{Binding RhythmCommand}" CommandParameter="Nefes egzersizi yapalım"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Notlar. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Notlar" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="4" ToolTip="notes.md'yi aç"
                                                Command="{Binding OpenNotesCommand}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasNotes, Converter={StaticResource Hidden}}"
                                               Text="&quot;Not al: süt ve ekmek&quot; de, buraya yazayım. &quot;Notlarımı oku&quot; deyince okurum."/>
                                    <ItemsControl ItemsSource="{Binding RecentNotes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:NoteView}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Söyleyebileceklerin. -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Dene" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TodayIdeas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Margin="-4,0,0,0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Content="{Binding}" Padding="11,6"
                                                        Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= Sohbet ================= -->
                <Grid Visibility="{Binding IsChat, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Boş durum: küre, selam ve öneriler. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasLines, Converter={StaticResource Hidden}}">
                        <local:AudioRing x:Name="HeroRing" Width="190" Height="190" Level="{Binding Level}" State="{Binding State}"/>
                        <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" Margin="0,10,0,6"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WakeHint}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                        <TextBlock Text="Dinleme, anlama ve düşünme bu bilgisayarda yapılır." Foreground="{StaticResource FaintBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,22" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding Suggestions}" MaxWidth="620">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding}"
                                            Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasLines, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource ChatLineTemplate}" Margin="0,8,14,0"/>
                    </ScrollViewer>

                    <!-- Yazma alanı: yüzen, yumuşak köşeli bir kutu. -->
                    <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="18" Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Padding="18,13,60,13" FontSize="14"
                                     Background="Transparent" BorderThickness="0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Friday'e yaz…" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="20,0,0,0"
                                       VerticalAlignment="Center" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" HorizontalAlignment="Right"
                                    Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= Ritim ================= -->
                <ScrollViewer Visibility="{Binding IsRhythm, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Margin="36,4,24,24">
                    <StackPanel Margin="0,0,12,0" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Bugün aktif" Style="{StaticResource Label}" Margin="0"/>
                                        <TextBlock Text="{Binding RhythmActive}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="12,6" Background="{StaticResource AccentSoftBrush}"
                                            Visibility="{Binding InFocus, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding FocusRemaining}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </Border>
                                </Grid>
                                <local:RhythmTimeline Segments="{Binding RhythmSegments}" Now="{Binding RhythmNow}" Margin="0,18,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Rectangle Width="10" Height="6" RadiusX="3" RadiusY="3" Fill="#6E6A62" VerticalAlignment="Center"/>
                                    <TextBlock Text="Çalışma" Style="{StaticResource Caption}" Margin="6,0,16,0"/>
                                    <Rectangle Width="10" Height="6" RadiusX="3" RadiusY="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Odak" Style="{StaticResource Caption}" Margin="6,0,16,0"/>
                                    <TextBlock Text="Boşluklar mola" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="-6,0,-6,14">
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="Odak" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding RhythmFocus}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="Mola" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding RhythmBreaks}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="En uzun aralıksız" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding RhythmLongest}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="Su (bardak)" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding RhythmWater}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Bu hafta" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding WeekBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:WeekBarView}">
                                            <StackPanel Margin="6,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <Grid Height="90">
                                                    <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="6" Background="#3A3936"/>
                                                </Grid>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Day" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Şu anki oturum" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding RhythmStretch}" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                                <Grid Height="6">
                                    <Border CornerRadius="3" Background="#222226"/>
                                    <Border CornerRadius="3" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7FD4B0" Offset="0"/>
                                                <GradientStop Color="#F2CC8F" Offset="0.7"/>
                                                <GradientStop Color="#FF8A5B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding RhythmProgress}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <WrapPanel Margin="-4,16,0,0">
                                    <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Mola ver">
                                        <TextBlock Text="Mola ver"/>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="25 dakika odaklanacağım"
                                            Content="25 dk odak"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="50 dakika odaklanacağım"
                                            Content="50 dk odak"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Odağı bitir"
                                            Content="Odağı bitir" Visibility="{Binding InFocus, Converter={StaticResource Visible}}"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Nefes egzersizi yapalım"
                                            Content="Nefes egzersizi"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Esneme yapalım"
                                            Content="Esneme"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Su içtim"
                                            Content="Su içtim"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource FaintBrush}" FontSize="12">
                            Friday yalnızca son klavye ve fare kullanım zamanını okur; tuşlara, ekrana ya da pencere içeriklerine bakmaz. Mola önerisi
                            yazarken değil bir duraksamada gelir; tam ekran bir oyun, film ya da sunum açıkken araya girmez. "Mola ver", "25 dakika
                            odaklanacağım", "nefes egzersizi", "nerede kalmıştım" ya da "bugün ne kadar çalıştım" diyebilirsin.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= Hafıza ================= -->
                <Grid Visibility="{Binding IsMemory, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{Binding MemorySummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ImportFileCommand}" Margin="0,0,8,0"
                                    ToolTip="ChatGPT, Claude ya da Gemini'den .txt, .md ya da .json">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dosyadan aktar"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding TogglePasteCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Metin yapıştır"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CopyForAiCommand}" Margin="0,0,8,0"
                                    ToolTip="Başka bir yapay zekâya yapıştırılacak mesajı panoya koyar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Başka bir AI'ya taşı"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding ExportMemoryCommand}" ToolTip="Markdown olarak dışa aktar">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Metin yapıştırma kutusu. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsPasteOpen, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="2,0,0,10"
                                       Text="ChatGPT'de Ayarlar › Kişiselleştirme › Hafızayı yönet listesini, Claude ya da Gemini'nin kayıtlı bilgilerini buraya yapıştır."/>
                            <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="130" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding TogglePasteCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource AccentButton}" Content="Bilgileri ayıkla" Command="{Binding ParsePasteCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Elle ekleme. -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <TextBox Text="{Binding NewMemory, UpdateSourceTrigger=PropertyChanged}" Padding="16,11,110,11">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddMemoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Bir bilgi ekle: ör. Kahveyi şekersiz içerim." Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"
                                   Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewMemory}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource AccentButton}" Content="Hatırla" Command="{Binding AddMemoryCommand}"
                                HorizontalAlignment="Right" Margin="0,0,5,0" Height="32"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasImport, Converter={StaticResource Hidden}}">
                            <StackPanel>
                                <TextBlock Text="{Binding MemoryMessage}" Foreground="{StaticResource CalmBrush}" FontSize="12" Margin="2,2,0,10"/>
                                <TextBlock Text="Henüz bir şey hatırlamıyorum. &quot;Unutma, …&quot; demen ya da başka bir yapay zekâdan aktarman yeter."
                                           Foreground="{StaticResource FaintBrush}" Margin="0,24,0,0" HorizontalAlignment="Center"
                                           Visibility="{Binding HasMemories, Converter={StaticResource Hidden}}"/>
                                <ItemsControl ItemsSource="{Binding Memories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:MemoryView}">
                                            <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,13,4,13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/>
                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="9" Padding="10,4" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                                                            Margin="12,0,6,0" Visibility="{Binding HasCountdown, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{Binding Countdown}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2" x:Name="Forget" Style="{StaticResource IconButton}" ToolTip="Unut" Opacity="0"
                                                            Command="{Binding DataContext.ForgetMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Forget" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- İçe aktarma önizlemesi. -->
                        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasImport, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportSource, StringFormat='{}{0} hafızası'}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Grid>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding CancelImportCommand}" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Seçilenleri hatırla" Command="{Binding ConfirmImportCommand}"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ImportCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ImportCandidateView}">
                                                <Grid Margin="12,8,12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="Fact" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20"/>
                                                        <TextBlock Text="Zaten biliyorum" Style="{StaticResource Caption}"
                                                                   Visibility="{Binding AlreadyKnown, Converter={StaticResource Visible}}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding AlreadyKnown}" Value="True">
                                                        <Setter TargetName="Fact" Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Gizlilik ================= -->
                <Grid Visibility="{Binding IsPrivacy, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="-6,0,-6,18">
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Mikrofon" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding MicrophoneSummary}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Bilgisayarda kalan" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding LocalCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource CalmBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Dışarı giden" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding OutboundCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="1" Text="Bugünün defteri" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ledger}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LedgerView}">
                                    <Grid Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,13,0,0"/>
                                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource LineBrush}" HorizontalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" x:Name="Dot" Width="7" Height="7" Fill="{StaticResource CalmBrush}" VerticalAlignment="Top" Margin="0,16,0,0"/>
                                        <StackPanel Grid.Column="2" Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="19"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" x:Name="FlowText" Text="{Binding FlowLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource CalmBrush}"
                                                   VerticalAlignment="Top" Margin="0,13,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="FlowText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Rutinler ================= -->
                <Grid Visibility="{Binding IsRoutines, Converter={StaticResource Visible}}" Margin="36,4,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16">
                        "Çalışma modunu aç", "Günaydın" ya da "Mola" demen yeter. Rutinleri settings.json içindeki Routines bölümünden düzenleyebilirsin.
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Routines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RoutineView}">
                                    <Border Style="{StaticResource Card}" Width="272" Margin="0,0,14,14">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                                    Command="{Binding DataContext.RunRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Çalıştır"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:RoutineStepView}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource FaintBrush}" Width="18" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="200" Margin="8,0,0,0" LineHeight="19"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Ayarlar ================= -->
                <ScrollViewer Visibility="{Binding IsSettings, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Margin="36,4,24,24">
                    <StackPanel Margin="0,0,12,0" MaxWidth="740" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Uyandırma ve ritim" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WakeEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WakeLabel, StringFormat='&quot;{0}&quot; ile uyan'}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0"
                                                   Text="Mikrofon açık kalır ama ses yalnızca bellekte, 80 ms'lik parçalar halinde puanlanıp atılır. Kapalıyken yalnızca kısayol çalışır."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,18" Visibility="{Binding WakeEnabled, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Hassasiyet" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border Style="{StaticResource SegmentTrack}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="Kolay uyan" IsChecked="{Binding WakeSensitive}"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="Normal" IsChecked="{Binding WakeNormal}"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="Seçici" IsChecked="{Binding WakeStrict}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RhythmEnabled}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Ritim koçu" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0"
                                                   Text="Uzun süre aralıksız çalışınca uygun bir anda mola önerir; dönünce kaldığın yeri söyler."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,18" Visibility="{Binding RhythmEnabled, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Mola önerisi" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border Style="{StaticResource SegmentTrack}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="30 dk" IsChecked="{Binding BreakEvery30}"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="50 dk" IsChecked="{Binding BreakEvery50}"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" Content="90 dk" IsChecked="{Binding BreakEvery90}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MorningEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Sabah karşılaması" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0"
                                                   Text="Günün ilk oturuşunda havayı ve yaklaşan tarihleri kısaca söyler."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Karakter" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sana nasıl hitap etsin" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Varsayılan şehir" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Kişilik" Style="{StaticResource Label}"/>
                                <Border Style="{StaticResource SegmentTrack}" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Esprili" IsChecked="{Binding PersonalityWitty}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Sade" IsChecked="{Binding PersonalityPlain}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Resmi" IsChecked="{Binding PersonalityFormal}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Cevaptan sonra devam sorusu bekle" Style="{StaticResource Label}"/>
                                <Border Style="{StaticResource SegmentTrack}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Kapalı" IsChecked="{Binding FollowUpOff}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="4 sn" IsChecked="{Binding FollowUpShort}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="7 sn" IsChecked="{Binding FollowUpLong}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Ses" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                <TextBlock Text="Motor" Style="{StaticResource Label}"/>
                                <Border Style="{StaticResource SegmentTrack}" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Piper · yerel, hızlı" IsChecked="{Binding EnginePiper}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="XTTS · klonlanabilir" IsChecked="{Binding EngineXtts}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Azure nöral" IsChecked="{Binding EngineAzure}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16" FontSize="12">
                                    Piper bu bilgisayarda anında konuşur ve ekran kartı kullanmaz. XTTS konuşurken ~1,8 GB VRAM kullanır ama istediğin bir sesi
                                    6–15 saniyelik bir kayıttan klonlayabilir (settings.json: XttsVoiceSample).
                                </TextBlock>

                                <TextBlock Text="XTTS sesi" Style="{StaticResource Label}"/>
                                <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-3,0,0,8" ItemContainerStyle="{StaticResource PillItem}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding PreviewVoiceCommand}" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Seçili sesi dinle"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Azure (isteğe bağlı)" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,10">
                                    Ücretsiz F0 katmanı ayda 500 bin karakter verir. Azure'a yalnızca okunacak cevap metni gider, mikrofon sesi gitmez.
                                </TextBlock>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Speech anahtarı" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="AzureKeyBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bölge" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SegmentTrack}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Emel (kadın)" IsChecked="{Binding VoiceEmel}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Ahmet (erkek)" IsChecked="{Binding VoiceAhmet}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding EngineLabel, StringFormat='Şu an kullanılan: {0}'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Mikrofon" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,12">
                                    Otomatik'te bütün mikrofonlar dinlenir ve seni duyan seçilir; sanal cihazlar (ör. SteelSeries Sonar) sorun olmaz.
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-3,0,0,0" ItemContainerStyle="{StaticResource PillItem}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Modeller ve bellek" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource Body}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Kaydet ve uygula" Command="{Binding SaveSettingsCommand}" Padding="18,9"/>
                            <Button Style="{StaticResource GhostButton}" Content="settings.json" Command="{Binding OpenSettingsFileCommand}" Margin="10,0,0,0" Padding="14,9"/>
                            <Button Style="{StaticResource GhostButton}" Content="Veri klasörü" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0" Padding="14,9"/>
                            <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource CalmBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
