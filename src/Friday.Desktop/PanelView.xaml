<UserControl x:Class="Friday.Desktop.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource TextFont}"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <local:InverseVisibilityConverter x:Key="Hidden"/>

        <!-- Sol gezinme düğmesi: simge + küçük etiket, seçiliyken vurgu çizgisi. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Height="58">
                            <Rectangle x:Name="Bar" Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}" Opacity="0"/>
                            <Border x:Name="Pill" Width="48" Height="48" CornerRadius="14" Background="Transparent">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="17"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="9.5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tuş görünümlü küçük kutu (Ctrl, Alt, F). -->
        <DataTemplate x:Key="KeyCap">
            <Border CornerRadius="6" BorderThickness="1,1,1,2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceRaisedBrush}"
                    Padding="7,2" Margin="2,0" MinWidth="24">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChatLineTemplate" DataType="{x:Type local:ChatLine}">
            <Grid Margin="0,0,0,14">
                <StackPanel x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="560">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,5">
                        <TextBlock x:Name="Who" Text="FRIDAY" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border x:Name="Body" CornerRadius="4,16,16,16" Padding="14,10" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" FontSize="13.5"/>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Body" Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                    <Setter TargetName="Body" Property="BorderBrush" Value="#1E4A6E"/>
                    <Setter TargetName="Body" Property="CornerRadius" Value="16,4,16,16"/>
                    <Setter TargetName="Who" Property="Text" Value="SEN"/>
                    <Setter TargetName="Who" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sol gezinme ================= -->
        <Border Background="#07090D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,14">
                <local:AudioRing DockPanel.Dock="Top" x:Name="NavRing" Width="54" Height="54" Margin="0,0,0,18"
                                 Level="{Binding Level}" State="{Binding State}"/>
                <Ellipse DockPanel.Dock="Bottom" Width="8" Height="8" Fill="{Binding StateBrush}" ToolTip="{Binding StatusText}"/>
                <StackPanel Margin="10,0,0,0">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="Sohbet" IsChecked="{Binding IsChat}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Hafıza" IsChecked="{Binding IsMemory}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Gizlilik" IsChecked="{Binding IsPrivacy}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Rutinler" IsChecked="{Binding IsRoutines}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Ayarlar" IsChecked="{Binding IsSettings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Üst bilgi ================= -->
            <Grid Margin="28,20,28,10">
                <StackPanel>
                    <TextBlock Text="{Binding AssistantName}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="konuşmak için" Foreground="{StaticResource FaintBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding HotkeyKeys}" ItemTemplate="{StaticResource KeyCap}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyNote}" Foreground="{StaticResource WarningBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ================= Sohbet ================= -->
                <Grid Visibility="{Binding IsChat, Converter={StaticResource Visible}}" Margin="28,6,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Boş durum: büyük halka ve öneriler. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasLines, Converter={StaticResource Hidden}}">
                        <local:AudioRing x:Name="HeroRing" Width="170" Height="170" Level="{Binding Level}" State="{Binding State}"/>
                        <TextBlock Text="Kısayola bas ve konuş, ya da aşağıya yaz." HorizontalAlignment="Center" Margin="0,12,0,4"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="17"/>
                        <TextBlock Text="Mikrofon yalnızca kısayoldan sonra açılır. Dinleme, anlama ve düşünme bu bilgisayarda yapılır."
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <ItemsControl ItemsSource="{Binding Suggestions}" MaxWidth="600">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding}"
                                            Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasLines, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource ChatLineTemplate}" Margin="0,8,8,0"/>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Padding="16,12,56,12" FontSize="13.5">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Friday'e yaz…" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="18,0,0,0"
                                   VerticalAlignment="Center" FontSize="13.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Draft}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" HorizontalAlignment="Right"
                                Width="36" Height="36" Padding="0" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="14" Foreground="#06121A"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ================= Hafıza ================= -->
                <Grid Visibility="{Binding IsMemory, Converter={StaticResource Visible}}" Margin="28,6,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14">
                        Friday'in senin hakkında bildikleri. "Unutma, …" diyerek ekleyebilir, "… bilgisini unut" diyerek silebilirsin.
                        Hepsi yalnızca bu bilgisayarda, D:\Friday\data\memory.json dosyasında durur.
                    </TextBlock>
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <TextBox Text="{Binding NewMemory, UpdateSourceTrigger=PropertyChanged}" Padding="14,10,110,10">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddMemoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Ör. Kahveyi şekersiz içerim." Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"
                                   Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewMemory}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource AccentButton}" Content="Hatırla" Command="{Binding AddMemoryCommand}"
                                HorizontalAlignment="Right" Margin="0,0,5,0" Height="32"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Henüz bir şey hatırlamıyorum." Foreground="{StaticResource FaintBrush}" Margin="0,20,0,0"
                                       HorizontalAlignment="Center" Visibility="{Binding HasMemories, Converter={StaticResource Hidden}}"/>
                            <ItemsControl ItemsSource="{Binding Memories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MemoryView}">
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,10" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" ToolTip="Unut" Padding="8,6" BorderThickness="0"
                                                        Command="{Binding DataContext.ForgetMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{StaticResource FaintBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Gizlilik ================= -->
                <Grid Visibility="{Binding IsPrivacy, Converter={StaticResource Visible}}" Margin="28,6,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="-6,0,-6,16">
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Foreground="{StaticResource ListeningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="MİKROFON" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MicrophoneSummary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Foreground="{StaticResource SpeakingBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="BİLGİSAYARDA KALAN" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LocalCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="DIŞARI GİDEN" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding OutboundCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="1" Text="Bugünün defteri" Style="{StaticResource SectionTitle}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ledger}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LedgerView}">
                                    <Grid Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                        <!-- Zaman çizgisi. -->
                                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource LineBrush}" HorizontalAlignment="Center"/>
                                        <Border Grid.Column="1" x:Name="Dot" Width="22" Height="22" CornerRadius="11" Background="#1A2EE6A6"
                                                VerticalAlignment="Top" Margin="0,8,0,0">
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="10.5" Foreground="{StaticResource SpeakingBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,9,12,12">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" x:Name="Flow" CornerRadius="6" Padding="7,2" Background="#142EE6A6" VerticalAlignment="Top" Margin="0,10,0,0">
                                            <TextBlock x:Name="FlowText" Text="{Binding FlowLabel}" Style="{StaticResource Caption}" Foreground="{StaticResource SpeakingBrush}"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="#1AFFB547"/>
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="Flow" Property="Background" Value="#1AFFB547"/>
                                            <Setter TargetName="FlowText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Rutinler ================= -->
                <Grid Visibility="{Binding IsRoutines, Converter={StaticResource Visible}}" Margin="28,6,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16">
                        "Çalışma modunu aç" ya da "Günaydın" demen yeter. Rutinleri settings.json içindeki Routines bölümünden düzenleyebilirsin.
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Routines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RoutineView}">
                                    <Border Style="{StaticResource Card}" Width="270" Margin="0,0,14,14" Padding="18">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                                    Command="{Binding DataContext.RunRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Çalıştır"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:RoutineStepView}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource FaintBrush}" Width="20"/>
                                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="200" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Ayarlar ================= -->
                <ScrollViewer Visibility="{Binding IsSettings, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Margin="28,6,20,22">
                    <StackPanel Margin="0,0,8,0" MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Ses" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="MOTOR" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <Border CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="2" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Piper · yerel, hızlı" IsChecked="{Binding EnginePiper}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="XTTS · klonlanabilir" IsChecked="{Binding EngineXtts}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Azure nöral" IsChecked="{Binding EngineAzure}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14">
                                    Piper bu bilgisayarda anında konuşur ve ekran kartı kullanmaz; değişken tonlama ve hafif oda sesiyle sentetikliği azaltılmıştır
                                    (settings.json: PiperNoiseScale, PiperNoiseW, VoiceRoom). XTTS, konuşurken ~1,8 GB VRAM kullanır ama istediğin bir sesi
                                    klonlayabilir: XttsVoiceSample'a 6–15 saniyelik bir .wav kaydının yolunu yaz.
                                </TextBlock>

                                <TextBlock Text="XTTS SESİ" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-3,0,0,8">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Pill" CornerRadius="10" Padding="12,6" Margin="3" BorderThickness="1"
                                                                BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceRaisedBrush}">
                                                            <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding PreviewVoiceCommand}" Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Seçili sesi dinle"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="AZURE (İSTEĞE BAĞLI)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10">
                                    Ücretsiz F0 katmanı ayda 500 bin karakter verir. Azure'a yalnızca okunacak cevap metni gider, mikrofon sesi gitmez.
                                </TextBlock>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AZURE SPEECH ANAHTARI" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <PasswordBox x:Name="AzureKeyBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="BÖLGE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="AZURE SESİ" Style="{StaticResource Caption}" Margin="0,4,0,6"/>
                                <Border CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Emel (kadın)" IsChecked="{Binding VoiceEmel}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Ahmet (erkek)" IsChecked="{Binding VoiceAhmet}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding EngineLabel, StringFormat='Şu an kullanılan: {0}'}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Karakter" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SANA NASIL HİTAP ETSİN" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VARSAYILAN ŞEHİR" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="KİŞİLİK" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <Border CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Esprili" IsChecked="{Binding PersonalityWitty}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Sade" IsChecked="{Binding PersonalityPlain}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Resmi" IsChecked="{Binding PersonalityFormal}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="CEVAPTAN SONRA DEVAM SORUSU BEKLE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <Border CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="Kapalı" IsChecked="{Binding FollowUpOff}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="4 sn" IsChecked="{Binding FollowUpShort}"/>
                                        <RadioButton Style="{StaticResource SegmentOption}" Content="7 sn" IsChecked="{Binding FollowUpLong}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Modeller ve GPU" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding ModelSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Kaydet ve uygula" Command="{Binding SaveSettingsCommand}" Padding="18,9"/>
                            <Button Style="{StaticResource GhostButton}" Content="settings.json'u aç" Command="{Binding OpenSettingsFileCommand}" Margin="10,0,0,0" Padding="14,9"/>
                            <Button Style="{StaticResource GhostButton}" Content="Veri klasörü" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0" Padding="14,9"/>
                            <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource SpeakingBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
