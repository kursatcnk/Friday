<UserControl x:Class="Friday.Desktop.RhythmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop">
    <UserControl.Resources>
        <Style x:Key="RhythmPills" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="-3,0,0,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PillItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="HowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="36,4,24,24">
        <StackPanel Margin="0,0,12,0" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ================= Şu an: büyük halka ve canlı sayaç ================= -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="200" Height="200" Margin="0,0,30,0">
                        <local:ProgressDial Progress="{Binding DialProgress}" Color="{Binding DialColor}" Thickness="5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DialClock}" FontFamily="{StaticResource DisplayFont}" FontSize="42" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="{Binding DialCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Şu an" Style="{StaticResource Label}" Margin="0"/>
                        <TextBlock Text="{Binding DialLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,8"/>
                        <TextBlock Text="{Binding DialSentence}" Style="{StaticResource Body}" FontSize="13.5" LineHeight="21" MaxWidth="480" HorizontalAlignment="Left"/>

                        <!-- Kipe göre düğmeler. -->
                        <Grid Margin="0,16,0,0" MaxWidth="420" HorizontalAlignment="Left" Visibility="{Binding IsWorkMode, Converter={StaticResource Visible}}">
                            <TextBox x:Name="FocusTaskBox" Text="{Binding FocusTaskText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"
                                     ToolTip="Yazarsan odak oturumu o işe sayılır; bitince bitirip bitirmediğini sorarım."/>
                            <TextBlock Text="Ne üzerinde çalışacaksın? (isteğe bağlı)" Foreground="{DynamicResource FaintBrush}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="{Binding FocusTaskText, Converter={StaticResource TextHidden}}"/>
                        </Grid>
                        <WrapPanel Margin="-4,8,0,0" Visibility="{Binding IsWorkMode, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="mola" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC32;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentInkBrush}"/>
                                    <TextBlock Text="Mola ver" FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="odak:25" Content="25 dk odak"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="odak:50" Content="50 dk odak"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="odak:90" Content="90 dk odak"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="pomodoro:4" Content="4 pomodoro"
                                    ToolTip="25 dk odak + 5 dk mola, dört tur; duraklatılabilir, her an bitirilebilir"/>
                            <Border Margin="4" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceRaisedBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding CustomFocusMinutes, UpdateSourceTrigger=PropertyChanged}" Width="44" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Dakika (5–240)"/>
                                    <Button Style="{StaticResource GhostButton}" BorderThickness="0" Content="dk odak" Command="{Binding StartCustomFocusCommand}" Padding="4,8,12,8"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="-4,16,0,0" Visibility="{Binding IsFocusMode, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="duraklat" Padding="16,9" Content="Duraklat"
                                    Visibility="{Binding FocusPaused, Converter={StaticResource Hidden}}"/>
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="devam" Padding="16,9" Content="Devam et"
                                    Visibility="{Binding FocusPaused, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="uzat:10" Content="+10 dk"
                                    ToolTip="Odağı 10 dakika uzat"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="odakbitti" Content="Odağı bitir"
                                    Visibility="{Binding SeriesActive, Converter={StaticResource Hidden}}"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="seribitti" Content="Seriyi bitir"
                                    Visibility="{Binding SeriesActive, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="mola" Content="Mola ver"/>
                        </WrapPanel>
                        <WrapPanel Margin="-4,16,0,0" Visibility="{Binding IsBreakMode, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="molabitti" Padding="16,9" Content="Moladan döndüm"
                                    Visibility="{Binding SeriesActive, Converter={StaticResource Hidden}}"/>
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="molabitti" Padding="16,9" Content="Sıradaki tura geç"
                                    Visibility="{Binding SeriesActive, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Nefes egzersizi yapalım" Content="Nefes egzersizi"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding RhythmCommand}" CommandParameter="Esneme yapalım" Content="Esneme"/>
                            <Button Style="{StaticResource GhostButton}" Margin="4" Command="{Binding ControlCommand}" CommandParameter="seribitti" Content="Seriyi bitir"
                                    Visibility="{Binding SeriesActive, Converter={StaticResource Visible}}"/>
                        </WrapPanel>
                        <WrapPanel Margin="-4,16,0,0" Visibility="{Binding IsOffMode, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource AccentButton}" Margin="4" Command="{Binding EnableRhythmCommand}" Padding="16,9" Content="Ritim koçunu aç"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding RhythmNote}" Foreground="{DynamicResource CalmBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding RhythmNote, Converter={StaticResource TextVisible}}"/>
                        <TextBlock Text="{Binding FocusApps}" Style="{StaticResource Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding FocusApps, Converter={StaticResource TextVisible}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding RhythmRule}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Padding="5" Margin="6,0,0,0" ToolTip="Ritim ayarları" Command="{Binding GoToCommand}" CommandParameter="settings">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="10"/>
                            </Button>
                        </StackPanel>
                        <!-- Mola önerilerini sustur ya da yeniden aç (yalnızca çalışma kipinde). -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsWorkMode, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding SuggestionsPaused, Converter={StaticResource Hidden}}">
                                <TextBlock Text="Önerileri sustur:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding ControlCommand}" CommandParameter="durdur:60" Content="1 saat"/>
                                <TextBlock Text="·" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding ControlCommand}" CommandParameter="durdur:gun" Content="bugünlük"/>
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Command="{Binding ControlCommand}" CommandParameter="surdur" Content="Önerileri yeniden aç"
                                    Visibility="{Binding SuggestionsPaused, Converter={StaticResource Visible}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Hedef, seri ve odak sesi ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Günlük odak hedefi" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding GoalText}" Style="{StaticResource Body}" Margin="0,6,0,10"/>
                        <Grid Height="10" Margin="0,0,0,10">
                            <Border CornerRadius="5" Background="{DynamicResource LineBrush}"/>
                            <Border CornerRadius="5" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource Fraction}">
                                        <Binding Path="GoalFraction"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <ListBox Style="{StaticResource RhythmPills}" ItemsSource="{Binding GoalOptions}" SelectedItem="{Binding SelectedGoal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="230">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Seri" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StreakText}" Style="{StaticResource Body}" Margin="0,6,0,14" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"/>
                        <TextBlock Text="Odakta ses" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <ListBox Style="{StaticResource RhythmPills}" ItemsSource="{Binding FocusSoundOptions}" SelectedItem="{Binding SelectedFocusSound}" MaxWidth="300" HorizontalAlignment="Left"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EyeBreaks}" Margin="0,12,0,0" MaxWidth="300" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="20-20-20 göz molası" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="20 dakika aralıksız ekrandaysan 20 saniye uzağa bakmanı hatırlatır."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Bugün ================= -->
            <TextBlock Text="Bugün" Style="{StaticResource SectionTitle}" Margin="2,6,0,4"/>
            <TextBlock Text="{Binding RhythmSummary}" Style="{StaticResource Body}" Margin="2,0,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="5" Margin="-6,0,-6,14">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Bilgisayar başında" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding RhythmActive}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Odak" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding RhythmFocus}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="Mola" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding RhythmBreaks}" Style="{StaticResource StatValue}" Foreground="{DynamicResource CalmBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="En uzun aralıksız" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding RhythmLongest}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Su (bardak)" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding RhythmWater}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="7" ToolTip="Bir bardak su içtim"
                                Command="{Binding RhythmCommand}" CommandParameter="Su içtim">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ================= Günün akışı ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Günün akışı" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Bilgisayar başında geçen her aralık bir çubuk; aradaki boşluklar molaların."/>
                    <local:RhythmTimeline Segments="{Binding RhythmSegments}" Now="{Binding RhythmNow}" Margin="0,16,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Rectangle Width="12" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Çalışma" Style="{StaticResource Caption}" Margin="6,0,16,0"/>
                        <Rectangle Width="12" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Odak oturumu" Style="{StaticResource Caption}" Margin="6,0,16,0"/>
                        <Rectangle Width="12" Height="6" RadiusX="3" RadiusY="3" Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1" VerticalAlignment="Center"/>
                        <TextBlock Text="Boşluk = mola ya da uzakta" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <!-- Bugünkü odak oturumları ve işleri. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasFocusSessions, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding FocusSessionsSummary}" Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding FocusSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FocusSessionView}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Length}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Task}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Son 7 gün ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Son 7 gün" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding WeekAverage}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding WeekSummary}" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding WeekBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WeekBarView}">
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Height="110">
                                        <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3" Background="{DynamicResource TrackBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="Day" Text="{Binding Day}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= Nasıl çalışır ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Nasıl çalışır?" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="10,5" Command="{Binding ToggleRhythmHelpCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Göster"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowRhythmHelp}" Value="True">
                                                <Setter Property="Text" Value="Gizle"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <StackPanel Visibility="{Binding ShowRhythmHelp, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                    <UniformGrid Columns="3" Margin="-8,0">
                        <StackPanel Margin="8,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="18" Foreground="{DynamicResource SpeakingBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="1 · Ölçer" Style="{StaticResource HowTitle}"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12"
                                       Text="Yalnızca son klavye ya da fare kullanımının ne zaman olduğuna bakar. Tuşları, ekranı ya da pencereleri okumaz. 3 dakika dokunmazsan uzakta sayılırsın."/>
                        </StackPanel>
                        <StackPanel Margin="8,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEC32;" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="2 · Önerir" Style="{StaticResource HowTitle}"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12"
                                       Text="Ayarladığın süre boyunca ara vermeden çalışınca, yazmayı bıraktığın bir anda mola önerir. Tam ekran oyun, film ya da sunumda araya girmez; odaktayken susar."/>
                        </StackPanel>
                        <StackPanel Margin="8,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="18" Foreground="{DynamicResource CalmBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="3 · Hatırlatır" Style="{StaticResource HowTitle}"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12"
                                       Text="Moladan dönünce hangi pencerede kaldığını söyler. Odak oturumu bitince günün özetini verir; her şey bu bilgisayarda kalır."/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Sesle: &quot;Mola ver&quot;, &quot;25 dakika odaklanacağım&quot;, &quot;Moladan döndüm&quot;, &quot;Nerede kalmıştım?&quot;, &quot;Bugün ne kadar çalıştım?&quot;, &quot;Bu hafta nasıl geçti?&quot;, &quot;Odak hedefim 3 saat&quot;, &quot;Hedefime ne kadar kaldı?&quot;"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
