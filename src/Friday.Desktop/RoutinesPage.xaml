<UserControl x:Class="Friday.Desktop.RoutinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop"
             xmlns:core="clr-namespace:Friday.Core;assembly=Friday.Core">
    <Grid Margin="36,4,24,24">
        <!-- ================= Liste ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEditingRoutine, Converter={StaticResource Hidden}}">
            <StackPanel Margin="0,0,12,0">
                <Grid Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,170,0" TextWrapping="Wrap"
                               Text="Bir rutin, tek cümleyle sırayla yapılan işlerdir: uygulama aç, sesi ayarla, odak başlat, bir şey söyle. Adını söylemen yeter."/>
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding NewRoutineCommand}" Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource AccentInkBrush}"/>
                            <TextBlock Text="Yeni rutin" FontWeight="SemiBold" Foreground="{StaticResource AccentInkBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border CornerRadius="12" Background="#1FFFB86B" BorderBrush="#40FFB86B" BorderThickness="1" Padding="14,10" Margin="0,0,0,14"
                        Visibility="{Binding IsConfirmingRoutineDelete, Converter={StaticResource Visible}}">
                    <Grid>
                        <TextBlock Text="{Binding RoutineDeleteQuestion}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding CancelDeleteRoutineCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="Sil" Command="{Binding ConfirmDeleteRoutineCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding RoutineMessage}" Foreground="{StaticResource CalmBrush}" FontSize="12" Margin="2,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RoutineMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Routines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RoutineView}">
                            <Border x:Name="Card" Style="{StaticResource Card}" Width="262" Margin="0,0,14,14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.RunRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Çalıştır"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" ToolTip="Düzenle" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Key}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Sil"
                                                    Command="{Binding DataContext.AskDeleteRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Key}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Phrase}" Style="{StaticResource Caption}" Margin="0,3,0,12"/>
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:RoutineStepView}">
                                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                                                   Width="18" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <TextBlock x:Name="StepText" Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                                   MaxWidth="190" Margin="8,0,0,0" LineHeight="19"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter TargetName="StepText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Şablondan başla" Style="{StaticResource SectionTitle}" Margin="2,10,0,4"/>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="2,0,0,10" Text="Birine tıkla; düzenleyip kendine göre kaydet."/>
                <ItemsControl ItemsSource="{Binding RoutineTemplates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:RoutineTemplate}">
                            <Button Style="{StaticResource GhostButton}" Width="262" Margin="0,0,14,10" Padding="16,12" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="18,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Düzenleyici ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEditingRoutine, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,12,0" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding EditorTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Kapat" Command="{Binding CancelRoutineCommand}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Adı" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding RoutineName, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
                    <TextBlock Text="{Binding RoutinePhrase}" Style="{StaticResource Caption}" Margin="2,6,0,18"/>

                    <TextBlock Text="Adımlar (sırayla çalışır)" Style="{StaticResource Label}"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,8" Text="Henüz adım yok; aşağıdan ekle."
                               Visibility="{Binding EditorSteps.Count, Converter={StaticResource ZeroVisible}}"/>
                    <ItemsControl ItemsSource="{Binding EditorSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RoutineStepEditor}">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12"
                                        Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2" Visibility="{Binding NeedsValue, Converter={StaticResource Visible}}">
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Padding="10,7"/>
                                            <TextBlock Text="{Binding Hint}" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Value}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Yukarı" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Aşağı" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Adımı sil"
                                                    Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Adım ekle" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                    <ItemsControl ItemsSource="{Binding StepKinds}" Margin="-4,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:RoutineStepKind}">
                                <Button Style="{StaticResource ChipButton}" Padding="11,6"
                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding RoutineError}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="2,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RoutineError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Kaydet" Command="{Binding SaveRoutineCommand}" Padding="18,9" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding CancelRoutineCommand}" Padding="14,9"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding DeleteEditedRoutineCommand}" Padding="14,9"
                                Visibility="{Binding CanDeleteEditedRoutine, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" Margin="0,0,8,0" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="Rutini sil" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border CornerRadius="12" Background="#1FFFB86B" BorderBrush="#40FFB86B" BorderThickness="1" Padding="14,10" Margin="0,14,0,0"
                            Visibility="{Binding IsConfirmingRoutineDelete, Converter={StaticResource Visible}}">
                        <Grid>
                            <TextBlock Text="{Binding RoutineDeleteQuestion}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Command="{Binding CancelDeleteRoutineCommand}" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource AccentButton}" Content="Sil" Command="{Binding ConfirmDeleteRoutineCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
