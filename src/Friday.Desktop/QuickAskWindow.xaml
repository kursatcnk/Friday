<Window x:Class="Friday.Desktop.QuickAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Friday.Desktop"
        Title="Friday" Width="660" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource TextBrush}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="18" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="20,16,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="16" Foreground="{DynamicResource FaintBrush}" Margin="0,0,14,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="Input" FontSize="18" Background="Transparent" BorderThickness="0" Padding="0,4" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="Placeholder" Text="Sor ya da yaz…" FontSize="18" Foreground="{DynamicResource FaintBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border CornerRadius="6" BorderThickness="1,1,1,2" BorderBrush="{DynamicResource LineStrongBrush}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="7,1">
                        <TextBlock Text="Enter" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Border CornerRadius="6" BorderThickness="1,1,1,2" BorderBrush="{DynamicResource LineStrongBrush}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="7,1" Margin="5,0,0,0">
                        <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Border x:Name="ListArea" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,6,8,8">
                <ListBox x:Name="Suggestions" Background="Transparent" BorderThickness="0" MaxHeight="330" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Back" CornerRadius="10" Padding="12,8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverWashBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:QuickAskItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Border>
</Window>
