<UserControl x:Class="Friday.Desktop.AgendaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Friday.Desktop">
    <Grid Margin="36,4,24,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- Hızlı ekleme: "yarın 9'da dişçi" hatırlatma, "cuma sunumu bitir" iş olur. -->
                <Grid Margin="0,0,0,8">
                    <TextBox Text="{Binding NewAgendaItem, UpdateSourceTrigger=PropertyChanged}" Padding="16,11,110,11">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddAgendaItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Ekle: ör. yarın 9'da dişçi · cuma sunumu bitir · her pazartesi 8'de spor" Foreground="{DynamicResource FaintBrush}"
                               IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewAgendaItem}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,0,6,0" Padding="14,6" Command="{Binding AddAgendaItemCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,7,0" Foreground="{DynamicResource AccentInkBrush}"/>
                            <TextBlock Text="Ekle" FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <DockPanel Margin="2,4,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AgendaMessage}" Foreground="{DynamicResource CalmBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    <TextBlock Text="{Binding AgendaSummary}" Style="{StaticResource Caption}"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding AgendaDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:AdaptiveGrid MinItemWidth="240" Gap="14" Margin="0,0,0,14"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AgendaDayView}">
                            <Border x:Name="Card" Style="{StaticResource Card}" MinHeight="150" Margin="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Count, Converter={StaticResource TextVisible}}">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource FaintBrush}" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Boş bir gün." Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:AgendaEntryView}">
                                                <Grid x:Name="Row" Margin="0,3" Background="Transparent" ToolTip="{Binding KindLabel}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12"
                                                               Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Time}" FontSize="12" Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasTime, Converter={StaticResource Visible}}"/>
                                                        <TextBlock x:Name="What" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Opacity="0.35">
                                                        <Button Style="{StaticResource IconButton}" ToolTip="Tamamlandı" Width="26" Height="26"
                                                                Visibility="{Binding CanComplete, Converter={StaticResource Visible}}"
                                                                Command="{Binding DataContext.CompleteAgendaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" ToolTip="Sil" Width="26" Height="26"
                                                                Visibility="{Binding CanDelete, Converter={StaticResource Visible}}"
                                                                Command="{Binding DataContext.DeleteAgendaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tools" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Setter TargetName="What" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRoutine}" Value="True">
                                                        <Setter TargetName="What" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
