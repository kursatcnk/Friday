<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT: çalan medyanın bilgisi (GlobalSystemMediaTransportControls). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport kaynak üreticisi için (medya tuşları, pano, ekran görüntüsü). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UI Automation: pencereleri, sekmeleri ve düğmeleri okumak/kullanmak için. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Friday.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF bu ikisini örtük using listesinden çıkarıyor. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yerel XTTS ses sunucusu; Friday onu D:\Friday\tools\xtts-env içindeki Python ile çalıştırır. -->
    <None Include="Voice\xtts_server.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Friday.Core\Friday.Core.csproj" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Vulkan: NVIDIA/AMD/Intel GPU'larda ek kurulum gerektirmeden hızlandırma; yoksa CPU çalışma zamanına düşer. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Windows Arama dizini (dosya bulucu). -->
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
    <!-- Azure nöral ses (Emel/Ahmet), isteğe bağlı. -->
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.52.0" />
  </ItemGroup>

</Project>
